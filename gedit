#!/usr/bin/env python3
"""
Gemini 书稿编辑命令行工具
使用方法: ./gedit <command> [options]

快捷命令:
  p <text>     - 学术润色
  l <text>     - 课堂风格润色
  c <text>     - 精炼文本
  e <concept>  - 解释概念
  x <concept>  - 生成例子
  t <text>     - 翻译中文
  k <text>     - 检查严谨性
  i            - 交互模式
"""

import sys
import os
import subprocess
from pathlib import Path

# 切换到书稿目录
os.chdir("/Users/Min369/Desktop/书/书稿打磨")

def show_usage():
    print(__doc__)

def quick_polish(text, style="academic"):
    """快速润色"""
    cmd = f"python3 quick_edit.py polish --style {style} --text '{text}'"
    subprocess.run(cmd, shell=True)

def quick_explain(concept):
    """快速解释"""
    cmd = f"python3 quick_edit.py explain --concept '{concept}'"
    subprocess.run(cmd, shell=True)

def quick_example(concept):
    """快速生成例子"""
    cmd = f"python3 quick_edit.py example --concept '{concept}'"
    subprocess.run(cmd, shell=True)

def quick_translate(text):
    """快速翻译"""
    cmd = f"python3 quick_edit.py translate --text '{text}'"
    subprocess.run(cmd, shell=True)

def quick_check(text):
    """快速检查"""
    cmd = f"python3 quick_edit.py check --text '{text}'"
    subprocess.run(cmd, shell=True)

def interactive_mode():
    """交互模式"""
    subprocess.run("python3 quick_edit.py interactive", shell=True)

def main():
    if len(sys.argv) < 2:
        show_usage()
        return

    command = sys.argv[1].lower()

    if command in ['help', 'h', '-h', '--help']:
        show_usage()
        return

    elif command == 'p':
        if len(sys.argv) < 3:
            print("❌ 请输入要润色的文本")
            return
        text = ' '.join(sys.argv[2:])
        quick_polish(text, "academic")

    elif command == 'l':
        if len(sys.argv) < 3:
            print("❌ 请输入要润色的文本")
            return
        text = ' '.join(sys.argv[2:])
        quick_polish(text, "lecture")

    elif command == 'c':
        if len(sys.argv) < 3:
            print("❌ 请输入要精炼的文本")
            return
        text = ' '.join(sys.argv[2:])
        quick_polish(text, "concise")

    elif command == 'e':
        if len(sys.argv) < 3:
            print("❌ 请输入要解释的概念")
            return
        concept = ' '.join(sys.argv[2:])
        quick_explain(concept)

    elif command == 'x':
        if len(sys.argv) < 3:
            print("❌ 请输入要生成例子的概念")
            return
        concept = ' '.join(sys.argv[2:])
        quick_example(concept)

    elif command == 't':
        if len(sys.argv) < 3:
            print("❌ 请输入要翻译的文本")
            return
        text = ' '.join(sys.argv[2:])
        quick_translate(text)

    elif command == 'k':
        if len(sys.argv) < 3:
            print("❌ 请输入要检查的文本")
            return
        text = ' '.join(sys.argv[2:])
        quick_check(text)

    elif command == 'i':
        interactive_mode()

    else:
        print(f"❌ 未知命令: {command}")
        show_usage()

if __name__ == "__main__":
    main()