# --- 把中间文件统一到 build/ ---
$out_dir = 'build';
$aux_dir = 'build';

# --- 使用 xelatex 模式 ---
$pdf_mode = 5;  # xelatex
$pdflatex = 'xelatex -synctex=1 -interaction=nonstopmode -file-line-error %O %S';

# --- 正确调用 biber 到 build/ 目录 ---
# 注意：这里明确告诉 biber 去 build/ 找/写 .bcf/.bbl/.blg
$biber = 'biber --input-dir build --output-dir build %O %B';

# 让 latexmk 自动侦测 biblatex+biber 流程更稳妥
$bibtex_fudge = 1;

# --- 成功后把 PDF 复制回根目录（可选） ---
$end_hook = sub {
  my $pdf = "$out_dir/$root_filename.pdf";
  if (-e $pdf) { system("cp -f $pdf $root_filename.pdf"); }
};
